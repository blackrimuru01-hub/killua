	function subscribeNewsletter() {
		$(".hintField").val("");
		var email = trim($("#newsletter_email").val());
		if (isEmpty(email)) {
			info("Please input your email address.");
			return;
		}
		
		if (!isEmail(email)) {
			info("Please input your email address correctly.");
			return;
		}
	
		jQuery.ajax({
			type: "POST",
			url: "https://www.sfs.edu.sy/en/",
			data: { email: email },
    		success: function(rspTxt) {
				$(".submit").attr("disabled", false);
				
				try {
					eval("var rsp = " + rspTxt);
				} catch(e) {
					return;
				}
				
				if ("success" == rsp.result) {
					info("We have received your email address and you'll get updates, special offers from JABARTOTO");
				} else {
					info(rsp.messages[0]);
				}
			},
			error: function(xhr, status) {
				$(".submit").attr("disabled", false);
				// alert(status);
			}
		});
	}
