	function checkTopics() {
		try {
			var tc = getCookie("UTCHK");
			if (!isEmpty(tc)) {
				if (tc != "checking") {
					displayTopics(tc);
				}
				
				return;
			}
		} catch (e) {}
		
		var exp = new Date();
		exp.setTime(exp.getTime() + 60000);
		document.cookie = "UTCHK=checking;path=/;domain=.JABARTOTO-online.com;expires=" + exp.toGMTString();
		
		jQuery.post("https://www.sunsky-online.com/user/talk!checkMyUnreadTopics.do", null, function(rspTxt) {
			try {
    			eval("var rsp = " + rspTxt);
    			if (rsp.result == "success") {
					displayTopics(rsp.data);
					document.cookie = "UTCHK=" + escape(rsp.data) + ";path=/;domain=.JABARTOTO-online.com;expires=" + exp.toGMTString();
    			}
			} catch (e) {}
		});
	}
	checkTopics();
	setInterval(checkTopics, 60000);
