:root{
  --mb-bg1:#020b14;
  --mb-bg2:#001a2a;
  --mb-line:rgba(255,23,68,0.25);

  --mb-neon:#FF1744;
  --mb-neon2:#D50000;
  --mb-hot:#FF1744;

  --mb-text:#e9fbff;
  --mb-shadow:0 -6px 30px rgba(0,0,0,.65);
  --mb-font:"Poppins","Segoe UI",sans-serif;
}

.JABARTOTO-login-daftar-footer{
  position:fixed;
  bottom:0; left:0; right:0;
  z-index:999;
  display:flex;
  justify-content:space-evenly;
  align-items:center;
  padding:12px 6px 10px;

  background:
    linear-gradient(180deg, rgba(255,23,68,0.08), transparent 30%),
    linear-gradient(180deg, var(--mb-bg1), var(--mb-bg2));

  border-top:1px solid var(--mb-line);
  box-shadow: var(--mb-shadow);
  backdrop-filter: blur(10px);
  border-radius:22px 22px 0 0;
  font-family:var(--mb-font);
  overflow:hidden;
}

/* scanline slash */
.JABARTOTO-login-daftar-footer::before{
  content:"";
  position:absolute;
  inset:-80%;
  background:
    linear-gradient(120deg, transparent 45%, rgba(255,23,68,0.12) 50%, transparent 55%);
  animation: footerSlash 6s linear infinite;
  pointer-events:none;
  mix-blend-mode:screen;
}

@keyframes footerSlash{
  from{ transform:translateX(-20%) rotate(-12deg); }
  to{ transform:translateX(20%) rotate(-12deg); }
}

/* ===============================
   FOOTER BUTTON
=============================== */
.JABARTOTO-login-daftar-footer a{
  flex:1;
  max-width:90px;
  text-align:center;
  text-decoration:none;
  color:var(--mb-text);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.4px;
  position:relative;
  transition:.25s ease;
  z-index:1;
}

/* icon */
.JABARTOTO-login-daftar-footer img{
  width:26px;
  height:26px;
  filter:
    drop-shadow(0 0 6px rgba(255,23,68,0.4))
    drop-shadow(0 0 12px rgba(0,188,212,0.25));
  transition:.25s ease;
}

/* hover */
.JABARTOTO-login-daftar-footer a:hover{
  transform:translateY(-6px) scale(1.08);
  color:var(--mb-neon);
  text-shadow:0 0 10px rgba(255,23,68,0.7);
}

.JABARTOTO-login-daftar-footer a:hover img{
  transform:scale(1.2);
  filter:
    drop-shadow(0 0 12px var(--mb-neon))
    drop-shadow(0 0 22px var(--mb-neon2));
}

/* active click */
.JABARTOTO-login-daftar-footer a:active{
  transform:scale(.95);
  opacity:.85;
}

/* ===============================
   CENTER CORE BUTTON (DAFTAR)
=============================== */
.JABARTOTO-login-daftar-footer .core{
  background:
    radial-gradient(circle at 30% 30%, rgba(255,23,68,0.25), transparent 55%),
    linear-gradient(145deg, #001018, #002a3a);

  border-radius:50%;
  padding:12px;
  transform:scale(1.25);

  box-shadow:
    0 0 16px rgba(255,23,68,0.35),
    0 0 32px rgba(0,188,212,0.25);

  animation: corePulse 2.4s infinite alternate;
}

@keyframes corePulse{
  0%{
    box-shadow:
      0 0 10px rgba(255,23,68,0.25),
      0 0 22px rgba(0,188,212,0.2);
  }
  100%{
    box-shadow:
      0 0 22px rgba(255,23,68,0.5),
      0 0 44px rgba(0,188,212,0.35);
  }
}

/* label highlight */
.JABARTOTO-login-daftar-footer .core span{
  color:var(--mb-neon);
  text-shadow:0 0 12px rgba(255,23,68,0.7);
}

/* ===============================
   RESPONSIVE
=============================== */
@media(max-width:500px){
  .JABARTOTO-login-daftar-footer{
